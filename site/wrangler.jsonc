{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yomiage-kun-site",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "yomiage.yusuke-hayashi.com",
      "custom_domain": true
    }
  ]
}
