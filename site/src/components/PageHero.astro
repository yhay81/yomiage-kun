---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  <div class="page-hero-orbit" aria-hidden="true">
    <span class="orbit-card orbit-one">Aa</span>
    <span class="orbit-line"></span>
    <span class="orbit-card orbit-two">
      <i></i><i></i><i></i>
    </span>
  </div>
</section>
