{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yomiage-kun",
  "version": "0.1.0",
  "identifier": "io.github.yhay81.yomiagekun",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yomiage-kun",
        "width": 1060,
        "height": 820,
        "minWidth": 720,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first Japanese TTS bot for Discord",
    "longDescription": "Discordの日本語チャットを、あなたのWindowsまたはMacから低遅延で読み上げます。",
    "copyright": "Copyright © 2018-2026 Yusuke Hayashi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
